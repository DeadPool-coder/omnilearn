# Variables del proxy opcional (server/proxy.mjs). Copia este archivo a .env o expórtalas en tu servidor.
# Nunca subas tus claves reales al repositorio.

# Claves de los proveedores (define solo las que uses)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1   # u OpenRouter, Groq, etc.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Código de acceso opcional: quien use la app lo escribe en el campo "Clave de API"
PROXY_TOKEN=

# Orígenes permitidos por CORS (no hace falta si la app se sirve desde el propio proxy)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Límites
RATE_LIMIT_PER_MIN=60
MAX_BODY_BYTES=2000000
PORT=8787
